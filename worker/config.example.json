{
  "serverUrl": "http://YOUR-GATEWAY-HOST:3900",
  "token": "WORKER_ID.PASTE_PAIRING_TOKEN_HERE",
  "name": "my-pc",
  "workspaces": [
    "C:/path/to/code-workspace",
    {
      "path": "C:/path/to/managed-vault-content",
      "deliveryMode": "trust-cli"
    }
  ],
  "runners": [
    "codex",
    "claude",
    "grok",
    "opencode"
  ],
  "maxConcurrent": 2,
  "codexCommand": "codex.cmd",
  "codexModel": "",
  "codexWindowsSandbox": "unelevated",
  "claudeCommand": "claude.cmd",
  "allowShell": false,
  "allowSsh": false,
  "allowCamera": false,
  "cameraDevice": "Logitech BRIO",
  "ffmpegCommand": "ffmpeg",
  "allowTaobao": false,
  "taobaoMcpUrl": "http://localhost:3654/mcp",
  "grokCommand": "C:/Users/YOUR-USER/.grok/bin/grok.exe",
  "grokModel": "",
  "opencodeCommand": "opencode.cmd",
  "opencodeModel": "opencode-go/muse-spark-1.3-contributor",
  "opencodeStall": {
    "enabled": true,
    "noOutputMs": 720000,
    "noProgressMs": 600000,
    "diagnoseGraceMs": 180000,
    "killGraceMs": 15000,
    "checkIntervalMs": 5000,
    "maxRecoveries": 1,
    "cpuWatch": true,
    "cpuEpsilonMs": 50,
    "cpuBusyRatio": 0.05,
    "degradedConfirmMultiplier": 3,
    "toolLimitMs": 600000,
    "ttlGuardMs": 300000
  }
}
