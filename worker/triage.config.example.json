{
  "stateFile": "data/triage.db",
  "pollMs": 1000,
  "maxAttempts": 5,
  "claimTimeoutMs": 300000,
  "categories": [
    "calendar",
    "file-change",
    "rss",
    "backlog",
    "message",
    "system",
    "daily",
    "idea",
    "other"
  ],
  "deepseek": {
    "baseUrl": "https://api.deepseek.com",
    "apiKeyEnv": "DEEPSEEK_API_KEY",
    "flashModel": "deepseek-v4-flash",
    "proModel": "deepseek-v4-pro",
    "timeoutMs": 30000,
    "backlogMaxChars": 2000,
    "pricing": {
      "flash": {
        "inputCnyPerMillion": 0,
        "outputCnyPerMillion": 0
      },
      "pro": {
        "inputCnyPerMillion": 0,
        "outputCnyPerMillion": 0
      }
    }
  },
  "hub": {
    "baseUrl": "http://127.0.0.1:3900",
    "tokenEnv": "HUB_TOKEN",
    "timeoutMs": 30000
  },
  "vault": {
    "url": "http://127.0.0.1:8900/mcp",
    "tokenEnv": "VAULT_TOKEN",
    "sourceTag": "codex",
    "backlogQuery": "triage-backlog",
    "cacheMs": 300000
  },
  "routing": {
    "fuzzyFallback": true,
    "rules": {
      "calendar": "calendar-owner",
      "file-change": "engineering",
      "backlog": "task-owner"
    }
  },
  "proactive": {
    "enabled": true,
    "dailyDispatchLimit": 10,
    "minDailyDispatches": 1,
    "forceAfterHour": 18,
    "minimumGapMinutes": 180,
    "silentStartHour": 0,
    "silentEndHour": 9,
    "recipients": ["claude-code", "codex", "grok-build"]
  },
  "idea": {
    "enabled": false,
    "roomId": "room-contact-id",
    "hostName": "DS 主持",
    "dailyDispatchLimit": 1,
    "reactionRounds": 3,
    "recentTopicLimit": 12,
    "maxTopicAttempts": 3,
    "roundPollMs": 2000,
    "roundTimeoutMs": 1200000
  },
  "breakers": {
    "dailyEvents": 2000,
    "dailyCostCny": 5
  },
  "webhook": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 3911,
    "tokenEnv": "TRIAGE_WEBHOOK_TOKEN"
  },
  "sources": [
    {
      "id": "quarter-hour-check",
      "type": "timer",
      "intervalMinutes": 15,
      "jitterSeconds": 900,
      "category": "system",
      "summary": "Review current backlog and only act when there is concrete unfinished work."
    },
    {
      "id": "daily-check-in",
      "type": "timer",
      "mode": "daily",
      "intervalMinutes": 45,
      "jitterSeconds": 900,
      "category": "daily",
      "summary": "Proactive daily companion check for the AI Hub user. Prefer natural care, reminders, or light openers over empty noise."
    },
    {
      "id": "daily-idea-room",
      "type": "timer",
      "mode": "idea",
      "intervalMinutes": 1440,
      "jitterSeconds": 3600,
      "category": "idea",
      "summary": "Choose one novel free-form topic and host a room discussion."
    },
    {
      "id": "vault-backlog",
      "type": "vault-backlog",
      "intervalMinutes": 15,
      "query": "triage-backlog",
      "emitInitial": false
    },
    {
      "id": "project-watch",
      "type": "file",
      "path": "/srv/projects",
      "recursive": false,
      "category": "file-change"
    },
    {
      "id": "example-feed",
      "type": "http-diff",
      "url": "https://example.com/feed.xml",
      "intervalMinutes": 30,
      "category": "rss",
      "emitInitial": false
    }
  ]
}
