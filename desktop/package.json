{
  "name": "ai-hub-desktop",
  "productName": "ai-hub",
  "private": true,
  "version": "0.1.0",
  "description": "ai-hub desktop shell (Electron)",
  "main": "main.cjs",
  "scripts": {
    "prepare:app": "node scripts/prepare.mjs",
