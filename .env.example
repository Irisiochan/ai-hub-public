# Optional CLI/MCP/deploy credentials. Leave unused values empty.
CLAUDE_CODE_OAUTH_TOKEN=
# Shared by ai-hub and the versioned Memory Vault service. Use a long random value
# if the MCP endpoint will ever be exposed outside the internal Compose network.
VAULT_TOKEN=
DEPLOY_TOKEN=
# Versioned Memory Vault release used by docker-compose.example.yml.
MEMORY_VAULT_VERSION=v0.4.1
# hub-auto semantic review. Keep this only in .env / systemd EnvironmentFile.
DEEPSEEK_API_KEY=
DEEPSEEK_CAPTURE_MODEL=deepseek-v4-flash
# Optional OpenAI-compatible override; defaults to https://api.deepseek.com.
DEEPSEEK_API_BASE_URL=
