# Optional CLI/MCP/deploy credentials. Leave unused values empty.
CLAUDE_CODE_OAUTH_TOKEN=
# Shared by ai-hub and the bundled memory-vault service. Use a long random value
# if the MCP endpoint will ever be exposed outside the internal Compose network.
VAULT_TOKEN=
DEPLOY_TOKEN=
# Web password / triage-to-hub bearer. Generate with: openssl rand -hex 32
HUB_TOKEN=
# Versioned Memory Vault release used by docker-compose.example.yml.
MEMORY_VAULT_VERSION=v0.7.0
# hub-auto semantic review. Keep this only in .env / systemd EnvironmentFile.
DEEPSEEK_API_KEY=
DEEPSEEK_CAPTURE_MODEL=deepseek-v4-flash
# Optional OpenAI-compatible override; defaults to https://api.deepseek.com.
DEEPSEEK_API_BASE_URL=

# Optional WeChat iLink bot channel. The bearer and allow-list stay only in .env.
WECHAT_CHANNEL_ENABLED=false
WECHAT_BOT_TOKEN=
WECHAT_BOT_ID=
WECHAT_ALLOW_FROM=
# Usually leave these defaults untouched.
WECHAT_BASE_URL=https://ilinkai.weixin.qq.com
WECHAT_CDN_BASE_URL=https://novac2c.cdn.weixin.qq.com/c2c
WECHAT_LONG_POLL_MS=35000
